# Leave unset to run fully offline with the rule-based extractor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# USD per million tokens, used for the per-record cost log (defaults: Claude Haiku 5.5 list price)
LLM_PRICE_IN_PER_MTOK=0.10
LLM_PRICE_OUT_PER_MTOK=0.50
LLM_CONCURRENCY=8
LLM_BATCH_SIZE=50
DEDUP_THRESHOLD=0.86
# Absolute path of the DuckDB warehouse file (default: ./warehouse/llm_etl.duckdb)
LLM_ETL_DUCKDB=
